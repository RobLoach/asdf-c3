#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

mkdir -p "$ASDF_DOWNLOAD_PATH"

ext="tar.gz"
platform="linux"
if [[ "$OSTYPE" == "darwin"* ]]; then
	platform="macos"
	ext="zip"
elif [[ "$OSTYPE" == "cygwin" || "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
	platform="windows"
	ext="zip"
elif [[ "$OSTYPE" == "netbsd"* ]]; then
	platform="netbsd"
elif [[ "$OSTYPE" == "openbsd"* ]]; then
	platform="openbsd"
elif ldd --version 2>&1 | grep -qi musl; then
	# musl-based Linux (e.g. Alpine) needs the musl build
	platform="linux-musl"
fi

release_file="$ASDF_DOWNLOAD_PATH/$TOOL_NAME-$ASDF_INSTALL_VERSION.$ext"

# Download tar.gz file to the download directory
download_release "$ASDF_INSTALL_VERSION" "$release_file" "$platform" "$ext"

# Extract contents of file into the download directory
if [[ $ext == "zip" ]]; then
	unzip -oq "$release_file" -d "$ASDF_DOWNLOAD_PATH" || fail "Could not extract $release_file"

	# Ensure the archive is flattened to the top-directory.
	for dir in "$ASDF_DOWNLOAD_PATH/c3" "$ASDF_DOWNLOAD_PATH/macos"; do
		if [[ -d "$dir" ]]; then
			mv "$dir"/* "$ASDF_DOWNLOAD_PATH"
			rmdir "$dir"
		fi
	done
	unset dir
elif [[ $ext == "tar.gz" ]]; then
	tar -xzf "$release_file" -C "$ASDF_DOWNLOAD_PATH" --strip-components=1 || fail "Could not extract $release_file"
fi

# Remove the file since we don't need to keep it
rm "$release_file"

# Clean up the variables
unset ext
unset platform
unset release_file
